generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ServerStatus {
  STARTING
  RESTARTING
  RUNNING
  STOPPING
  STOPPED
  ARCHIVED
}

enum TransactionType {
  EARNED
  SPENT
}

enum QueueStatus {
  WAITING
  PROCESSING
  STARTING
  RESTARTING
  COMPLETED
  FAILED
  CANCELLED
}

enum TicketStatus {
  OPEN
  PENDING
  CLOSED
}

enum PremiumOrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  CREDIT_CLAIM
  VOUCHER
  REFERRAL
  SERVER_START
  SERVER_STOP
  SERVER_AUTO_STOP
  QUEUE_UPDATE
  ADMIN_ADJUSTMENT
  SYSTEM
  TICKET_UPDATE
}

model User {
  id        String   @id @default(uuid())
  discordId String   @unique
  username  String
  avatar    String?
  email     String?  @unique
  role      Role     @default(USER)
  balance   Float    @default(12.5) // Realistic starting balance
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pterodactylUserId Int?

  servers           Server[]
  transactions      CreditsTransaction[]
  referralsMade     Referral[]           @relation("Referrer")
  referralsReceived Referral[]           @relation("Referred")
  voucherClaims     VoucherClaim[]
  queueJobs         QueueJob[]
  supportTickets    SupportTicket[]
  ticketMessages    TicketMessage[]
  premiumOrders     PremiumOrder[]
  notifications     Notification[]
  serverAccesses    ServerAccess[]
  serverActivityLogs ServerActivityLog[]
}

model Admin {
  id             String    @id @default(uuid())
  username       String    @unique
  password       String
  discordId      String?   @unique // Optional now
  email          String?   @unique
  resetOtp       String?
  resetOtpExpiry DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Server {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  name         String
  ramGB        Float
  cpu          Float        @default(100)
  disk         Float        @default(10)
  status       ServerStatus @default(STOPPED)
  nodeLocation String       @default("mumbai") // Indian nodes only
  costPerHour  Float
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  pterodactylServerId   Int?
  pterodactylIdentifier String?

  billingLogs ServerBillingLog[]
  queueJobs   QueueJob[]
  accesses    ServerAccess[]
  activityLogs ServerActivityLog[]
  subdomain   ServerSubdomain?
  pluginLogs  PluginInstallLog[]
}

model CreditsTransaction {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  amount    Float
  type      TransactionType
  source    String // e.g., 'daily_spin', 'hourly_claim', 'server_cost'
  timestamp DateTime        @default(now())
}

model Referral {
  id           String   @id @default(uuid())
  referrerId   String
  referrer     User     @relation("Referrer", fields: [referrerId], references: [id])
  referredId   String
  referred     User     @relation("Referred", fields: [referredId], references: [id])
  status       String   @default("COMPLETED")
  rewardAmount Float
  createdAt    DateTime @default(now())
}

model Voucher {
  id           String    @id @default(uuid())
  code         String    @unique
  rewardAmount Float
  maxUses      Int
  currentUses  Int       @default(0)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  claims VoucherClaim[]
}

model VoucherClaim {
  id        String   @id @default(uuid())
  voucherId String
  voucher   Voucher  @relation(fields: [voucherId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  claimedAt DateTime @default(now())

  @@unique([voucherId, userId])
}

model QueueJob {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  serverId  String
  server    Server      @relation(fields: [serverId], references: [id])
  action    String // START, RESTART
  status    QueueStatus @default(WAITING)
  position  Int?
  priority  Int         @default(10)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model ServerBillingLog {
  id             String   @id @default(uuid())
  serverId       String
  server         Server   @relation(fields: [serverId], references: [id])
  amountDeducted Float
  reason         String
  timestamp      DateTime @default(now())
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  subject   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  messages  TicketMessage[]
}

model TicketMessage {
  id           String        @id @default(uuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id])
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  message      String
  isStaffReply Boolean       @default(false)
  createdAt    DateTime      @default(now())
}

model PremiumOrder {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  status      PremiumOrderStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Setting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model SettingAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  key       String
  oldValue  String?
  newValue  String
  timestamp DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  // Optional for unauthenticated actions
  action     String
  resource   String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())
}

model ServerAccess {
  id        String   @id @default(uuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String // JSON string array of permissions or comma separated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serverId, userId])
}

model ServerActivityLog {
  id        String   @id @default(uuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  ipAddress String?
  details   String?  // Additional context
  createdAt DateTime @default(now())
}

model ServerSubdomain {
  id        String   @id @default(uuid())
  serverId  String   @unique
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  subdomain String   @unique
  status    String   @default("Pending DNS Provisioning") // Pending DNS Provisioning, Active
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PluginInstallLog {
  id        String   @id @default(uuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  pluginName String
  version   String?
  installedAt DateTime @default(now())
}
